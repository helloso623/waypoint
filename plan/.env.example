# Anthropic API key -- required for goal auto-chunking, daily summaries, contact suggestions.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Optional role-specific Claude/Fable-style overrides. Keep chat/planning/judgment on Anthropic
# models because those paths use tool-use, web search, and safety/judgment prompts.
AGENT_CHAT_MODEL=
ORCHESTRATOR_MODEL=
CODE_CLAUDE_MODEL=

# Optional OpenAI/GPT-style routing for high-volume tasks, practice games, and code Q&A.
# If OPENAI_API_KEY is empty, these roles automatically fall back to Grok (if set) or Claude.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
PRACTICE_AI_MODEL=
OPENAI_CODE_MODEL=gpt-5-codex
CODE_OPENAI_MODEL=

# Optional xAI / Grok API (OpenAI-compatible at https://api.x.ai/v1). Use for tasks,
# practice, Code-tab Q&A, and Agent chat (same tools as Claude, minus web search).
XAI_API_KEY=
GROK_MODEL=grok-4.5
CODE_GROK_MODEL=
# Optional override if you proxy xAI:
# XAI_API_BASE=https://api.x.ai/v1

# Optional backend routing overrides. Settings can also save route_* keys.
# Every role accepts auto, claude, openai, grok (most also allow ollama).
# Agent chat can run on Claude, ChatGPT, or Grok via chat_backends.py.
# If the chosen API fails, Waypoint walks the rest of the chain automatically.
ROUTE_CHAT=auto
ROUTE_PLANNING=auto
ROUTE_JUDGMENT=auto
ROUTE_ROLEPLAY=auto
ROUTE_TASKS=auto
ROUTE_PRACTICE=auto
ROUTE_CODING=auto

# Optional: extra model ids per provider (Settings can also save these).
# OPENAI_MODEL=gpt-5-mini
# GROK_MODEL=grok-4.5

# Optional GitHub repo + token for the Observe widget (opens/creates issues).
# WAYPOINT_GITHUB_REPO=helloso623/plan
# GITHUB_TOKEN=

# Local Ollama model. After a git pull, run `python plan/scripts/post_pull.py` (or Settings →
# Set up local AI) so these keys stay in WAYPOINT_DATA_DIR/.env. LOCAL_MODEL_URL and OLLAMA_URL
# are aliases — either works for chat fallback and the Code tab.
LOCAL_MODEL_ENABLED=false
LOCAL_MODEL_URL=http://127.0.0.1:11434
OLLAMA_URL=http://127.0.0.1:11434
LOCAL_MODEL_NAME=llama3.2:3b

# Daily email
EMAIL_MODE=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM_EMAIL=planner@localhost
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
PLANNER_TO_EMAIL=
DAILY_EMAIL_HOUR=7
APP_BASE_URL=http://127.0.0.1:5099

# SQLite database path. Point this at a stable location so app versions/copies all read the same data.
# Absolute path, or relative to the plan/ project directory. Default: plan/planner.db
PLANNER_DB_PATH=

# Obsidian vault to mirror Daily notes / Goals into.
# Defaults to the bundled obsidian_vault/ folder if unset.
OBSIDIAN_VAULT_PATH=

# Leave FLASK_HOST unset: 127.0.0.1 locally (app.py's default), 0.0.0.0 in the container
# (the Dockerfile sets it) -- setting it here would override the container's bind and make
# it unreachable from outside. Only set it if you specifically need to change the default.
# For Tailscale: prefer `python run_tailscale.py` (uses Tailscale Serve + localhost bind).
# Or set WAYPOINT_TAILSCALE=1 and FLASK_HOST=0.0.0.0 / FLASK_HOST=tailscale.
PORT=5099
# WAYPOINT_TAILSCALE=1
# WAYPOINT_TAILSCALE_SERVE=1
# APP_TRUST_TAILSCALE=true
# Optional gate for phone / Tailnet / LAN. Localhost still bypasses when APP_TRUST_LOCALHOST=true.
# APP_ACCESS_TOKEN=
# APP_TRUST_LOCALHOST=true
# APP_SECRET_KEY=

# NYU Brightspace (optional official D2L OAuth — NYU IT must issue the client).
# Any student can skip this and paste a Brightspace calendar feed in Settings → NYU.
# NYU_BRIGHTSPACE_HOST=brightspace.nyu.edu
# NYU_BRIGHTSPACE_CLIENT_ID=
# NYU_BRIGHTSPACE_CLIENT_SECRET=
# NYU_BRIGHTSPACE_REDIRECT_URI=http://127.0.0.1:5099/api/nyu/brightspace/oauth/callback
# NYU_ICS_ALLOWED_HOSTS=

# Off by default on purpose: Flask's debug mode exposes an interactive debugger that allows
# arbitrary code execution if reached over the network -- never turn this on anywhere but
# your own machine. Set to true locally only if you want the auto-reloader.
FLASK_DEBUG=false
